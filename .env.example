# Application
APP_NAME=AI Test API
DEBUG=false
API_PREFIX=/api/v1
API_VERSION=v1

# LLM — Ollama
LLM_PROVIDER=ollama
MODEL_OLLAMA=llama3.2
OLLAMA_TIMEOUT=600
OLLAMA_BASE_URL=http://localhost:11434

# LLM — OpenAI (optional, switch LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_test_api
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/ai_test_api_test

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

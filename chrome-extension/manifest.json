{
  "manifest_version": 3,
  "name": "AI Test API Capture",
  "version": "1.0.0",
  "description": "Capture API requests & responses and export them for AI-powered test generation.",

  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AI Test API Capture"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
